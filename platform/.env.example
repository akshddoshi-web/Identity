# Copy this file to .env and fill in as needed. Dummy defaults below are
# enough to boot the web app locally against Plaid's sandbox + free-tier
# data providers. See README.md for what each key unlocks.

# --- Database (docker-compose default, no changes needed for local dev) ---
DATABASE_URL="postgresql://identity:identity@localhost:5432/identity"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="dev-only-secret-change-me-00000000000000000000000000"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth is optional for local dev (email/password works without it).
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Encryption at rest for Plaid access tokens (>=16 chars) ---
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="dev-only-encryption-key-change-me-000000000000000"

# --- Plaid (sandbox mode works out of the box with a free Plaid account) ---
# Sign up free at https://dashboard.plaid.com/signup and use your Sandbox keys.
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"
# Only needed if you want live webhook delivery (e.g. via ngrok) in dev.
PLAID_WEBHOOK_URL=""

# --- Market data (Tier 1 investment screener) ---
# Free dev-tier key: https://www.alphavantage.co/support/#api-key
# The screener UI still renders without a key; "Refresh factors" will error until set.
MARKET_DATA_API_KEY=""

# --- Nutrition (USDA FoodData Central) ---
# Free key: https://fdc.nal.usda.gov/api-key-signup.html
# DEMO_KEY works out of the box at a very low rate limit.
USDA_API_KEY="DEMO_KEY"

# --- Background jobs (optional — omit to run the web app without Redis) ---
REDIS_URL="redis://localhost:6379"

NODE_ENV="development"
