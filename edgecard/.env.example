# Edge Card needs NO API keys: every data source it uses is free and keyless
# (nflverse, ESPN, Action Network public scoreboard, Kalshi public API,
# pbpstats, Open-Meteo, Google News RSS).
#
# Local runs: where results are read/written (a checkout of the edgecard-data
# branch, or any empty folder).
EDGECARD_DATA_DIR=./data/store
#
# Optional, only if you ever choose a paid odds feed later (not used by default):
# ODDS_API_KEY=
