# Base URL of the Identity API. For a physical device/simulator this must be your
# machine's LAN IP, not localhost (e.g. http://192.168.1.20:3000).
EXPO_PUBLIC_API_URL=http://localhost:3000

# Leave unset to run in dev-mode auth (see context/AuthContext.tsx) — the app
# will let you "sign in" with just a name + email, matching the API's
# ClerkAuthGuard dev fallback. Set this once you have a Clerk project
# (https://dashboard.clerk.com) to use real sign-in/sign-up.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
