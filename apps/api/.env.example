# Local dev Postgres (see root README for setup)
DATABASE_URL="postgresql://identity:identity@localhost:5432/identity_dev"

PORT=3000

# Clerk (https://dashboard.clerk.com) — leave unset locally to run the API in
# dev-auth mode (see src/auth/clerk-auth.guard.ts), which trusts an
# X-Dev-User-Email header instead of verifying a real Clerk session.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
